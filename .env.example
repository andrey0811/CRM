# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
DB_NAME=plant_crm
DB_USER=plant_crm
DB_PASSWORD=plant_crm_secret
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (SMTP) — xodim tasdiqlash kodi va anomaliya xabarlari uchun
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Plant CRM <noreply@plantcrm.local>
ADMIN_NOTIFICATION_EMAIL=admin@plantcrm.local

# Anomaliya aniqlash
ANOMALY_CLIENT_VIEWS_THRESHOLD=30
ANOMALY_WINDOW_MINUTES=10

# Faoliyat timeout (soat)
INACTIVITY_LOGOUT_HOURS=5
